# Client-side API URL.
# In development: full URL to the local API server.
# In production (Vercel): set to /api — requests are proxied to the backend
# via Next.js rewrites configured in next.config.js.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-only: direct backend URL used by server components.
# Only needed in production (set in Vercel dashboard).
# API_BACKEND_URL=https://your-api.onrender.com/api
