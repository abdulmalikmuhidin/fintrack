{
  "name": "fintrack",
  "version": "1.0.0",
  "description": "FinTrack - Personal Finance Application",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix apps/api run start:dev\" \"npm --prefix apps/web run dev\"",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/api run lint && npm --prefix apps/web run lint",
    "test": "npm --prefix apps/api run test",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "iconv-lite": "^0.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
